# ============================================================================
# LASTBENCH NOTIFICATION SERVER - ENVIRONMENT VARIABLES
# ============================================================================

# REQUIRED: Supabase Service Role Key
# Get this from: Supabase Dashboard → Project Settings → API → service_role key
# ⚠️ KEEP THIS SECRET! Never commit this to git
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# OPTIONAL: Debug Mode
# Set to 'true' to enable detailed logging
DEBUG=false

# OPTIONAL: Health Check Endpoint
# Enable HTTP health check endpoint for monitoring
ENABLE_HEALTH_CHECK=false

# OPTIONAL: Health Check Port
# Port for the health check endpoint (default: 3000)
HEALTH_CHECK_PORT=3000
