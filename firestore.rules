rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // --- COLLECTIONS ---

    // Users
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId); // Users can update their own profile

      // FCM Tokens subcollection
      // users/{userId}/fcmTokens/{token}
      match /fcmTokens/{token} {
        allow read, write: if isOwner(userId);
      }

      // Notifications subcollection
      // users/{userId}/notifications/{notificationId}
      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow write: if false; // Only Cloud Functions can write notifications
      }
    }

    // Profiles (Publicly readable user info)
    match /profiles/{profileId} {
      allow read: if true;
      allow write: if isOwner(request.resource.data.user_id);
    }

    // Posts
    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && isOwner(resource.data.author_id);
    }

    // Comments
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && isOwner(resource.data.author_id);
    }

    // Interactions (Likes, etc.)
    match /interactions/{interactionId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.user_id == request.auth.uid;
    }

    // Reports
    match /reports/{reportId} {
      allow create: if isSignedIn();
      allow read: if false; // Admin only
    }
  }
}
